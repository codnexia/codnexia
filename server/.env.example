# Environment: "production" or "development"
NODE_ENV=production

# Server port (default: 3000)
PORT=3000

# Neon PostgreSQL connection string
# Get yours from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT secret — use a strong random string (32+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-strong-random-secret

# Client URL (for CORS — must match your production domain)
CLIENT_URL=https://codnexia.uk

# SMTP (Gmail App Password recommended — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_TO=your-email@gmail.com

# Anthropic AI (Claude) — for AI recruitment pipeline
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
