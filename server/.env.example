# Neon PostgreSQL connection string
# Get yours from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT secret — use a strong random string (32+ characters in production)
JWT_SECRET=change-me-to-a-strong-random-secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# SMTP (Gmail App Password recommended — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_TO=your-email@gmail.com
